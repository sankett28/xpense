# Supabase — copy to .env.local and fill with your project's values.
# Project URL and anon key are safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key — server-only, NEVER expose to the browser. Optional for this
# phase; only needed if you script admin user creation locally.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
