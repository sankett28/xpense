# Supabase — copy to .env.local and fill with your project's values.
# URL and publishable key are safe to expose to the browser (RLS protects data).
# The publishable key (sb_publishable_...) is Supabase's current name for what
# used to be the "anon" key. Find both under Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# Service-role key — server-only, NEVER expose to the browser. Optional for this
# phase; only needed if you script admin user creation locally.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
